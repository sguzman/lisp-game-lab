(in-package #:lab.tests)

(defun test-assets ()
  (let* ((disposed nil)
         (slot (lab.assets:make-asset-slot
                :loader (lambda (bytes)
                          (when (zerop (aref bytes 0)) (error "Bad candidate"))
                          (list (aref bytes 0)))
                :disposer (lambda (resource) (push resource disposed)))))
    (assert (eq :accepted (lab.assets:install-bytes slot #(1))))
    (let ((original (lab.assets:asset-slot-value slot)))
      (assert (eq :rejected (lab.assets:install-bytes slot #(0))))
      (assert (eq original (lab.assets:asset-slot-value slot)))
      (assert (null disposed))
      (assert (= 1 (lab.assets:asset-slot-revision slot)))
      (assert (eq :accepted (lab.assets:install-bytes slot #(2))))
      (assert (eq original (first disposed)))
      (assert (= 2 (lab.assets:asset-slot-revision slot))))
    (let ((current (lab.assets:asset-slot-value slot)))
      (lab.assets:close-asset slot)
      (lab.assets:close-asset slot)
      (assert (eq current (first disposed)))
      (assert (= 2 (length disposed)))
      (assert (null (lab.assets:asset-slot-value slot)))))
  (flet ((bytes (text) (map 'vector #'char-code text)))
    (assert (equal '(100 120) (lab.assets:parse-position (bytes "100 120"))))
    (dolist (invalid '("100" "100 120 130" "a 120" "-1 120"
                       "737 120" "100 0" "#.(error)"))
      (assert (handler-case
                  (progn (lab.assets:parse-position (bytes invalid)) nil)
                (error () t)))))
  (format t "~&Asset transaction and data validation tests passed.~%")
  t)
