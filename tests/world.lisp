(in-package #:lab.tests)

(defun run-tests ()
  (let ((world (lab.core:make-world)))
    (assert (= 368 (lab.core:world-x world)))
    (assert (= 208 (lab.core:world-y world)))
    (assert (eq world (lab.core:move-world world 10 -20)))
    (assert (= 378 (lab.core:world-x world)))
    (assert (= 188 (lab.core:world-y world)))
    (lab.core:move-world world -1000 1000)
    (assert (zerop (lab.core:world-x world)))
    (assert (= (- lab.core:+height+ lab.core:+item-size+)
               (lab.core:world-y world)))
    (lab.core:move-world world 1000 -1000)
    (assert (= (- lab.core:+width+ lab.core:+item-size+)
               (lab.core:world-x world)))
    (assert (zerop (lab.core:world-y world))))
  (let ((world (lab.core:make-world :x -10 :y 10000)))
    (assert (zerop (lab.core:world-x world)))
    (assert (= (- lab.core:+height+ lab.core:+item-size+)
               (lab.core:world-y world))))
  (format t "~&World tests passed.~%")
  (test-scene)
  (test-reload)
  (test-assets)
  (test-console)
  (test-objects)
  (test-room)
  t)
