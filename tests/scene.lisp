(in-package #:lab.tests)

(defun test-scene ()
  (let* ((a (lab.scene:make-sprite :asset "a" :layer 2 :depth 20))
         (b (lab.scene:make-sprite :asset "b" :layer 0 :depth 99))
         (c (lab.scene:make-sprite :asset "c" :layer 2 :depth 10))
         (d (lab.scene:make-sprite :asset "d" :layer 2 :depth 20))
         (input (list a b c d)))
    (assert (equal (list b c a d) (lab.scene:draw-order input)))
    (assert (equal (list a b c d) input))
    (assert (null (lab.scene:draw-order nil))))
  (let ((camera (lab.scene:make-camera)))
    (lab.scene:pan-camera camera 1000 1000 1280 896 800 480)
    (assert (= 480 (lab.scene:camera-x camera)))
    (assert (= 416 (lab.scene:camera-y camera)))
    (assert (equal '(20 84)
                   (multiple-value-list
                    (lab.scene:screen-position camera 500 500))))
    (lab.scene:pan-camera camera -1000 -1000 1280 896 800 480)
    (assert (zerop (lab.scene:camera-x camera)))
    (assert (zerop (lab.scene:camera-y camera)))
    (lab.scene:pan-camera camera 10 10 200 200 800 480)
    (assert (zerop (lab.scene:camera-x camera)))
    (assert (zerop (lab.scene:camera-y camera))))
  (format t "~&Scene ordering and camera tests passed.~%")
  t)
