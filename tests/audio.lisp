(in-package #:lab.tests)

(defun test-audio ()
  (let ((mixer (lab.audio:make-mixer)))
    (assert (= 5 (lab.audio:mixer-volume mixer)))
    (assert (lab.audio:mixer-ambience-p mixer))
    (assert (> (lab.audio:gain mixer :effects) (lab.audio:gain mixer :ambience)))
    (assert (= 10 (lab.audio:adjust-volume mixer 100)))
    (let ((gain (lab.audio:gain mixer :effects)))
      (assert (lab.audio:toggle-mute mixer))
      (assert (zerop (lab.audio:gain mixer :effects)))
      (assert (zerop (lab.audio:gain mixer :ambience)))
      (assert (not (lab.audio:toggle-mute mixer)))
      (assert (= gain (lab.audio:gain mixer :effects))))
    (assert (= 0 (lab.audio:adjust-volume mixer -100)))
    (assert (zerop (lab.audio:gain mixer :ambience)))
    (assert (not (lab.audio:toggle-ambience mixer)))
    (assert (lab.audio:toggle-ambience mixer)))
  (format t "~&Audio mixer gain, mute and ambience tests passed.~%")
  t)
