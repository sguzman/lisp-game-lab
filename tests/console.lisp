(in-package #:lab.tests)

(defun test-console ()
  (let ((queue (lab.console:make-command-queue :capacity 2)))
    (assert (lab.console:enqueue queue "first"))
    (assert (lab.console:enqueue queue "second"))
    (assert (not (lab.console:enqueue queue "overflow")))
    (assert (string= "first" (lab.console:dequeue queue)))
    (assert (string= "second" (lab.console:dequeue queue)))
    (assert (null (lab.console:dequeue queue)))
    (assert (lab.console:enqueue queue "cancel me"))
    (assert (= 1 (lab.console:close-queue queue)))
    (assert (not (lab.console:queue-open-p queue)))
    (assert (not (lab.console:enqueue queue "after close")))
    (assert (null (lab.console:dequeue queue))))
  (let* ((queue (lab.console:make-command-queue))
         (input (make-string-input-stream (format nil "(state)~%(move 10 20)")))
         (reader (lab.console:start-reader queue input)))
    (assert (not (eq :timeout (sb-thread:join-thread reader :timeout 2 :default :timeout))))
    (assert (string= "(state)" (lab.console:dequeue queue)))
    (assert (string= "(move 10 20)" (lab.console:dequeue queue)))
    (assert (null (lab.console:dequeue queue)))
    (lab.console:close-queue queue))
  (let* ((world (lab.core:make-world))
         (session (lab.console:make-session :world world)))
    (multiple-value-bind (status value)
        (lab.console:evaluate-line session "(+ 2 3)")
      (assert (eq status :ok))
      (assert (equal value '(5))))
    (assert (eq :ok (lab.console:evaluate-line session "(move 10 20)")))
    (assert (= 378 (lab.core:world-x world)))
    (assert (= 228 (lab.core:world-y world)))
    (dolist (bad '("(move 1)" "(move 2 \"bad\")" "#.(error \"read eval\")"
                   "(move 10 20) (quit)" "(error \"test\")"))
      (assert (eq :error (lab.console:evaluate-line session bad)))
      (assert (= 378 (lab.core:world-x world)))
      (assert (= 228 (lab.core:world-y world))))
    (let ((worker (sb-thread:make-thread
                   (lambda ()
                     (handler-case
                         (progn (lab.console:evaluate-line session "(move 100 100)") nil)
                       (error () t))))))
      (assert (eq t (sb-thread:join-thread worker :timeout 2 :default :timeout))))
    (assert (eq :ok (lab.console:evaluate-line session "(teleport 120 140)")))
    (assert (= 120 (lab.core:world-x world)))
    (assert (= 140 (lab.core:world-y world)))
    (assert (eq :ok (lab.console:evaluate-line session "(quit)")))
    (assert (lab.console:session-stopping-p session))
    (assert (eq :rejected (lab.console:evaluate-line session "(move 1 1)"))))
  (format t "~&Console queue, evaluation, owner isolation and shutdown tests passed.~%")
  t)
