(in-package #:lab.tests)

(defun test-objects ()
  (let* ((board (lab.objects:make-demo-board))
         (base (first (lab.objects:board-items board)))
         (small (third (lab.objects:board-items board))))
    (assert (null (lab.objects:pick-item board 0 0)))
    (assert (eq small (lab.objects:pick-item board 550 160)))
    (lab.objects:drag-to board 180 200)
    (let ((x (lab.objects:item-x small))
          (y (lab.objects:item-y small)))
      (dotimes (i 4) (lab.objects:rotate-held board))
      (assert (= x (lab.objects:item-x small)))
      (assert (= y (lab.objects:item-y small)))
      (assert (zerop (lab.objects:item-turn small))))
    (lab.objects:rotate-held board)
    (assert (equal '(40 56) (multiple-value-list (lab.objects:dimensions small))))
    (assert (eq small (lab.objects:drop-held board)))
    (assert (= 1 (lab.objects:item-support small)))
    (assert (eq :stacked (lab.objects:board-status board)))
    (assert (eq small (car (last (lab.objects:draw-order board)))))
    ;; An occupied support cannot be moved independently.
    (assert (null (lab.objects:pick-item board 101 151)))
    (assert (eq :occupied (lab.objects:board-status board)))
    (let ((x (lab.objects:item-x small))
          (y (lab.objects:item-y small)))
      (assert (eq small (lab.objects:pick-item board 180 200)))
      (lab.objects:drag-to board -200 -200)
      (lab.objects:rotate-held board)
      (assert (null (lab.objects:drop-held board)))
      (assert (= x (lab.objects:item-x small)))
      (assert (= y (lab.objects:item-y small)))
      (assert (= 1 (lab.objects:item-turn small)))
      (assert (= 1 (lab.objects:item-support small)))
      (assert (eq :rejected (lab.objects:board-status board)))
      ;; Partial overlap with a non-support item is rejected.
      (assert (eq small (lab.objects:pick-item board 180 200)))
      (lab.objects:drag-to board 450 350)
      (assert (null (lab.objects:drop-held board)))
      (assert (= x (lab.objects:item-x small)))
      (assert (= y (lab.objects:item-y small))))
    (assert (eq small (lab.objects:pick-item board 180 200)))
    (lab.objects:drag-to board 650 330)
    (assert (eq small (lab.objects:drop-held board)))
    (assert (null (lab.objects:item-support small)))
    (assert (eq :placed (lab.objects:board-status board)))
    (assert (eq base (lab.objects:pick-item board 110 160)))
    (lab.objects:drag-to board 120 400)
    (lab.objects:cancel-drag board)
    (assert (= 100 (lab.objects:item-x base)))
    (assert (= 150 (lab.objects:item-y base))))
  (format t "~&Object placement, rotation, stacking and rollback tests passed.~%")
  t)
